PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/campuseats

JWT_SECRET=your_jwt_secret_here
JWT_CUSTOMER_EXPIRES_IN=7d
JWT_VENDOR_EXPIRES_IN=7d
JWT_RIDER_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="CampusEats <noreply@campuseats.ng>"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

OTP_EXPIRY_MINUTES=10
FRONTEND_URL=http://localhost:3000
